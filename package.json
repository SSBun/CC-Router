{
  "name": "@ssbun/cc-router",
  "version": "0.9.0",
  "description": "Multi-provider model router for Claude Code — route different models to different LLM providers",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "cc-router": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "tsup"
  },
  "keywords": [
    "claude-code",
    "llm",
    "proxy",
    "router",
    "anthropic",
    "openai"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SSBun/CC-Router.git"
  },
  "homepage": "https://github.com/SSBun/CC-Router",
  "bugs": {
    "url": "https://github.com/SSBun/CC-Router/issues"
  },
  "author": "Silas",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@clack/prompts": "^1.5.0",
    "@hono/node-server": "^1.14.0",
    "better-sqlite3": "^12.10.0",
    "chalk": "^5.4.0",
    "commander": "^13.1.0",
    "hono": "^4.7.0",
    "picomatch": "^4.0.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@types/picomatch": "^4.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
